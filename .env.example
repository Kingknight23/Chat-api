PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chat-api
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
KEY_ENCRYPTION_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
CORS_ORIGIN=http://YOUR_SERVER_OR_DOMAIN
TRUST_PROXY=false

# HTTP/WS deployment (requested)
HTTPS=false
